# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Make.com — Webhook URL del escenario que recibe el feedback negativo
# y lo reparte a WhatsApp (WATI/Cloud API) y/o correo, según reglas en Make.
# Se mantiene en paralelo al envío directo por Meta (abajo).
MAKE_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Prerrequisito: verificar el número de Boreas en Meta Business Manager y
# crear + aprobar las 2 plantillas (business-initiated ⇒ Meta exige plantilla).
# En desarrollo: modo de pruebas de Meta con números de test.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_DEFAULT_COUNTRY_CODE=57
# Plantilla alerta 1-2 estrellas. Params body: {{1}} negocio, {{2}} estrellas,
# {{3}} comentario, {{4}} contacto del cliente, {{5}} chip_code.
WHATSAPP_TEMPLATE_NEGATIVE_ALERT=boreas_alerta_resena_negativa

# Resend — https://resend.com/api-keys. El resumen periódico (antes semanal
# por WhatsApp, boreas_resumen_semanal) ahora es un reporte quincenal por
# correo, ver app/api/cron/biweekly-report. La alerta de 1-2 estrellas arriba
# sigue siendo WhatsApp, esto no la reemplaza.
RESEND_API_KEY=
# Sin dominio propio verificado en Resend, deja este vacío: cae al remitente
# de pruebas onboarding@resend.dev (entregable, pero revisa en tu dashboard de
# Resend si esa cuenta de pruebas restringe a qué destinatarios puede llegar).
# Con dominio verificado: "Boreas NFC Hub <reportes@tudominio.com>".
RESEND_FROM_EMAIL=

# Vercel Cron — secreto para autenticar la invocación de /api/cron/biweekly-report.
# Vercel lo manda como `Authorization: Bearer <CRON_SECRET>` automáticamente.
CRON_SECRET=

# Protección de /admin: login propio (app/login) con cookie de sesión
# firmada, ya no Basic Auth. Si dejas estos dos vacíos, /admin queda abierto.
ADMIN_USER=juan
ADMIN_PASSWORD=cambia-esto-por-algo-fuerte
# Secreto para firmar la cookie de sesión. Si lo dejas vacío, se firma con
# ADMIN_PASSWORD (funciona, pero un secreto propio es mejor práctica).
ADMIN_SESSION_SECRET=
